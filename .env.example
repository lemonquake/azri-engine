# Optional TURN server for robust multiplayer across symmetric NATs.
# Copy this file to `.env` and fill in your TURN credentials.
# Without these, multiplayer falls back to STUN-only (works for most, but not all, networks).
#
# Free/managed TURN options: metered.ca, Twilio NTS, or self-host coturn.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
